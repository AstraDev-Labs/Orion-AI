{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion",
  "version": "1.0.1",
  "identifier": "com.orion.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Orion",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOoUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://cdn.jsdelivr.net https://storage.googleapis.com; media-src 'self' blob: data: mediastream:; img-src 'self' data: blob:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "On-device AI assistant with energy monitoring and trace debugging",
    "longDescription": "Orion Desktop wraps the Orion research framework in a native desktop application with real-time energy monitoring, trace debugging, learning curve visualization, and memory browsing.",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRkNCNUUxMzk5REI0ODgKUldTSXRKMDU0Ylg4VFBPMi91cmFETTgxMGkvczVMdDdzTkJ4dkRHWURNRCtMcWMrWno4ZTZNRzAK",
      "endpoints": [
        "https://github.com/AstraDev-Labs/Orion-AI/releases/download/desktop-latest/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "orion"
        ]
      }
    }
  }
}
