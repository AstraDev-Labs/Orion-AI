---
import { Image } from 'astro:assets';
import logo from '../assets/orion-logo.png';
import DownloadButton from './DownloadButton.tsx';
import { NAV, STAGE, url } from '../lib/site';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---

<header class="sticky top-0 z-50 border-b border-[var(--color-line)] bg-[rgb(2_6_15/0.72)] backdrop-blur-md">
  <nav class="container-site flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href={url('/')} class="flex items-center gap-2.5" aria-label="Orion home">
      <Image src={logo} alt="" width={34} height={34} class="h-[34px] w-[34px]" loading="eager" />
      <span class="display text-[1.05rem] font-bold tracking-[0.22em] text-white">ORION</span>
      <span class="badge-alpha hidden sm:inline-flex !py-0.5 !text-[0.65rem]">{STAGE}</span>
    </a>

    <ul class="hidden items-center gap-7 text-sm text-[var(--color-muted)] md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={['transition-colors hover:text-white', path.startsWith(item.href) && item.href !== '/#features' && 'text-white']}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block">
        <DownloadButton client:idle label="Download" requirementsHref={url('/system-requirements')} />
      </div>
      <details class="relative md:hidden">
        <summary class="btn btn-ghost !px-3 !py-2 list-none" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="panel absolute right-0 mt-2 w-56 p-2" style="background:#07122a">
          {
            [...NAV, { label: 'Download', href: '/download' }].map((item) => (
              <a href={url(item.href)} class="block rounded-lg px-3 py-2.5 text-sm text-[var(--color-muted)] hover:bg-[rgb(56_189_248/0.08)] hover:text-white">
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>
