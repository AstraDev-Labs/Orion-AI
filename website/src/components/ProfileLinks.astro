---
/** GitHub and LinkedIn profile links for a team member. */
export type Profile = { kind: 'github' | 'linkedin'; href: string };

interface Props {
  name: string;
  profiles: Profile[];
  /** "buttons" shows labelled buttons; "icons" shows compact icon links. */
  variant?: 'buttons' | 'icons';
}

const { name, profiles, variant = 'icons' } = Astro.props;
const label = { github: 'GitHub', linkedin: 'LinkedIn' } as const;
---

<ul class:list={['flex flex-wrap', variant === 'buttons' ? 'gap-3' : 'gap-2']} aria-label={`${name}'s profiles`}>
  {
    profiles.map((p) => (
      <li>
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer me"
          class:list={[variant === 'buttons' ? 'btn btn-ghost' : 'profile-icon']}
          aria-label={variant === 'icons' ? `${name} on ${label[p.kind]} (opens in a new tab)` : undefined}
          title={variant === 'icons' ? `${name} on ${label[p.kind]}` : undefined}
        >
          {p.kind === 'github' ? (
            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" />
            </svg>
          ) : (
            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
            </svg>
          )}
          {variant === 'buttons' && label[p.kind]}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .profile-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line-strong);
    background: rgb(14 32 66 / 0.55);
    color: var(--color-muted);
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .profile-icon:hover {
    color: #fff;
    border-color: var(--color-cyan);
    background: rgb(14 32 66 / 0.9);
  }
</style>
