---
import SiteLayout from '../layouts/SiteLayout.astro';
import PcCheck from '../components/PcCheck.tsx';
import DownloadButton from '../components/DownloadButton.tsx';
import { url } from '../lib/site';

const specs = [
  ['Operating system', 'Windows 10 version 1809 or later', 'Windows 11'],
  ['Processor', '64-bit (x64), 4 threads', '8+ threads'],
  ['Memory (RAM)', '4 GB', '8 GB or more (16 GB is ideal)'],
  ['Free disk space', '12 GB on the install drive', '20 GB'],
  ['Graphics', 'Not required', 'NVIDIA GPU with 4 GB+ for faster replies'],
  ['Internet', 'Required during setup', 'Broadband for the multi-GB first download'],
  ['Audio', 'Speakers or headphones', 'A microphone to talk to Orion'],
  ['Account rights', 'Standard user (no admin needed)', ''],
];

const models = [
  ['8 GB or more', 'Qwen 3.5 4B', 'Best everyday quality'],
  ['6 GB', 'Qwen 3.5 2B', 'Good, faster'],
  ['4 GB', 'Qwen 3.5 0.8B', 'Basic answers'],
  ['Under 4 GB', 'Qwen 3 0.6B', 'Very limited'],
];
---

<SiteLayout title="System requirements" description="What your PC needs to run Orion, plus a live check of this computer: Windows version, 64-bit, memory, processor, graphics and microphone.">
  <section class="container-site max-w-5xl pb-6 pt-16 sm:pt-20">
    <p class="eyebrow">Before you install</p>
    <h1 class="display mt-4 text-4xl font-bold text-white sm:text-5xl">System requirements</h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
      Orion runs its AI on your own PC, so your hardware matters. Here’s what it needs, and a quick check of the computer you’re using right now.
    </p>
  </section>

  <section class="container-site max-w-5xl py-6">
    <PcCheck client:load />
  </section>

  <section class="container-site max-w-5xl py-10">
    <h2 class="text-2xl font-semibold text-white">Requirements</h2>
    <div class="panel mt-6 overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-left text-sm">
        <thead>
          <tr class="text-[var(--color-faint)]">
            <th class="px-5 py-3 font-medium">Component</th>
            <th class="px-5 py-3 font-medium">Minimum</th>
            <th class="px-5 py-3 font-medium">Recommended</th>
          </tr>
        </thead>
        <tbody>
          {
            specs.map(([c, min, rec]) => (
              <tr class="border-t border-[var(--color-line)]">
                <td class="px-5 py-3.5 font-medium text-white">{c}</td>
                <td class="px-5 py-3.5 text-[var(--color-muted)]">{min}</td>
                <td class="px-5 py-3.5 text-[var(--color-muted)]">{rec || '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 class="mt-14 text-2xl font-semibold text-white">Which AI model your PC gets</h2>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)]">Setup reads your PC’s memory and installs the most capable model that fits.</p>
    <div class="panel mt-6 overflow-x-auto">
      <table class="w-full min-w-[520px] border-collapse text-left text-sm">
        <thead>
          <tr class="text-[var(--color-faint)]">
            <th class="px-5 py-3 font-medium">Your memory</th>
            <th class="px-5 py-3 font-medium">Model</th>
            <th class="px-5 py-3 font-medium">What to expect</th>
          </tr>
        </thead>
        <tbody>
          {
            models.map(([m, model, q]) => (
              <tr class="border-t border-[var(--color-line)]">
                <td class="px-5 py-3.5 font-medium text-white">{m}</td>
                <td class="px-5 py-3.5 text-[var(--color-muted)]">{model}</td>
                <td class="px-5 py-3.5 text-[var(--color-muted)]">{q}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      <div class="panel p-6">
        <h3 class="font-semibold text-white">Not supported yet</h3>
        <ul class="mt-3 space-y-2 text-sm text-[var(--color-muted)]">
          <li>macOS and Linux (<a class="text-[var(--color-cyan-soft)] underline" href={url('/docs/build-from-source')}>build from source</a> instead)</li>
          <li>32-bit Windows, and Windows older than 10 version 1809</li>
          <li>Windows on ARM (untested)</li>
          <li>Phones and tablets</li>
        </ul>
      </div>
      <div class="panel p-6">
        <h3 class="font-semibold text-white">Good to know</h3>
        <ul class="mt-3 space-y-2 text-sm text-[var(--color-muted)]">
          <li>Setup installs Microsoft Edge WebView2 if it’s missing.</li>
          <li>Games and other heavy apps running at the same time slow Orion down.</li>
          <li>After setup, everyday use works offline, except web search, weather and messaging.</li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap items-center gap-3">
      <DownloadButton client:visible requirementsHref={url('/system-requirements')} />
      <a href={url('/docs')} class="btn btn-ghost">Install guide</a>
    </div>
  </section>
</SiteLayout>
