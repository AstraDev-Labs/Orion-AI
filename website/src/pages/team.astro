---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProfileLinks, { type Profile } from '../components/ProfileLinks.astro';
import { CONTACT_EMAIL, REPO_URL, url } from '../lib/site';

const owner = {
  name: 'Tharun',
  initials: 'T',
  roles: ['Developer', 'Product owner'],
  bio: [
    'Tharun created Orion and builds all of it: the AI agent runtime, voice, memory and tools, the Windows desktop app and installer, and this website.',
    'As product owner, Tharun sets Orion’s direction, decides what goes into each release, and keeps it true to its core promise: an assistant that runs on your own computer and acts only with your approval.',
  ],
  profiles: [
    { kind: 'github', href: 'https://github.com/TharunG2006' },
    { kind: 'linkedin', href: 'https://www.linkedin.com/in/tharun-g-b5b53a260/' },
  ] as Profile[],
};

const team: Array<{ name: string; initials: string; bio: string; profiles: Profile[] }> = [
  {
    name: 'Sanjay A.',
    initials: 'SA',
    bio: 'Helps bring Orion to new people and looks at each release with a security-first eye.',
    profiles: [
      { kind: 'github', href: 'https://github.com/sanjaynec' },
      { kind: 'linkedin', href: 'https://www.linkedin.com/in/sanjay-a-3b7ba9322/' },
    ],
  },
  {
    name: 'Yogaraj S.',
    initials: 'YS',
    bio: 'Shares Orion with the community and checks that its privacy promises hold up in practice.',
    profiles: [
      { kind: 'github', href: 'https://github.com/Yogaraj02' },
      { kind: 'linkedin', href: 'https://www.linkedin.com/in/yoga-raj-618aa3321/' },
    ],
  },
  {
    name: 'Raghavan P.',
    initials: 'RP',
    bio: 'Spreads the word about Orion and helps audit how it protects people’s data and accounts.',
    profiles: [{ kind: 'linkedin', href: 'https://www.linkedin.com/in/raghavan-p-347423310/' }],
  },
];

const focus = [
  {
    title: 'Marketing',
    points: [
      'Introducing Orion to people who want a private, on-device assistant',
      'Collecting feedback from alpha testers and passing it to development',
      'Keeping the website, release notes and announcements clear and accurate',
    ],
  },
  {
    title: 'Security audit',
    points: [
      'Reviewing how Orion asks for approval before messages, emails and installs',
      'Checking how personal data, keys and connected accounts are handled',
      'Testing that what Orion promises about privacy matches what it does',
    ],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Orion AI',
  url: Astro.site ? new URL(url('/'), Astro.site).href : undefined,
  email: CONTACT_EMAIL,
  founder: {
    '@type': 'Person',
    name: owner.name,
    jobTitle: 'Developer and Product Owner',
    sameAs: owner.profiles.map((p) => p.href),
  },
  member: team.map((m) => ({
    '@type': 'Person',
    name: m.name,
    jobTitle: 'Marketing & Security Audit',
    sameAs: m.profiles.map((p) => p.href),
  })),
};
---

<SiteLayout
  title="Developers & Team"
  description="Meet the people behind Orion: its developer and product owner, Tharun, and the Marketing & Security Audit team."
  schema={schema}
>
  <section class="container-site max-w-5xl pb-6 pt-16 sm:pt-20">
    <p class="eyebrow">Developers &amp; Team</p>
    <h1 class="display mt-4 text-4xl font-bold text-white sm:text-5xl">The people behind Orion</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
      Orion is an independent project. One developer designs and builds it, and a small team helps people discover it and holds it to a high bar on security and privacy.
    </p>
  </section>

  <!-- Developer & owner -->
  <section class="container-site max-w-5xl py-8" aria-labelledby="owner-heading">
    <h2 id="owner-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-faint)]">Developer &amp; Owner</h2>
    <article class="panel owner-card relative mt-4 overflow-hidden p-6 sm:p-9">
      <div class="flex flex-col gap-7 sm:flex-row sm:items-start">
        <div class="avatar avatar-lg" aria-hidden="true"><span>{owner.initials}</span></div>
        <div class="min-w-0">
          <h3 class="display text-3xl font-bold text-white">{owner.name}</h3>
          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Roles">
            {owner.roles.map((role) => <li class="role-chip">{role}</li>)}
          </ul>
          <div class="mt-5 space-y-3 text-[1.02rem] leading-relaxed text-[var(--color-muted)]">
            {owner.bio.map((p) => <p>{p}</p>)}
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <ProfileLinks name={owner.name} profiles={owner.profiles} variant="buttons" />
            <a href={REPO_URL} class="btn btn-ghost">Orion on GitHub</a>
          </div>
        </div>
      </div>
    </article>
  </section>

  <!-- Marketing & Security Audit -->
  <section class="container-site max-w-5xl py-10" aria-labelledby="team-heading">
    <h2 id="team-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-faint)]">Marketing &amp; Security Audit Team</h2>
    <p class="mt-4 max-w-2xl text-[1.02rem] leading-relaxed text-[var(--color-muted)]">
      The Marketing &amp; Security Audit team spreads the word about Orion and puts it under scrutiny, so the assistant people install is one they can trust.
    </p>

    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member) => (
          <li class="panel member-card flex flex-col p-6">
            <div class="flex items-center gap-4">
              <div class="avatar" aria-hidden="true"><span>{member.initials}</span></div>
              <div>
                <h3 class="text-lg font-semibold text-white">{member.name}</h3>
                <p class="text-sm text-[var(--color-cyan-soft)]">Marketing &amp; Security Audit</p>
              </div>
            </div>
            <p class="mt-4 flex-1 text-[0.97rem] leading-relaxed text-[var(--color-muted)]">{member.bio}</p>
            <div class="mt-5">
              <ProfileLinks name={member.name} profiles={member.profiles} />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        focus.map((area) => (
          <div class="rounded-2xl border border-[var(--color-line)] bg-[rgb(5_13_31/0.5)] p-6">
            <h3 class="font-semibold text-white">{area.title}</h3>
            <ul class="mt-3 space-y-2.5 text-[0.95rem] leading-relaxed text-[var(--color-muted)]">
              {area.points.map((point) => (
                <li class="flex gap-2.5">
                  <span aria-hidden="true" class="mt-[0.6rem] h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-cyan)]" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Get involved -->
  <section class="container-site max-w-5xl py-10">
    <div class="panel flex flex-col items-start justify-between gap-6 p-7 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-xl font-semibold text-white">Want to help?</h2>
        <p class="mt-2 max-w-xl text-[var(--color-muted)]">
          Report bugs, suggest features or contribute code on GitHub. Found a security problem? Please <a class="text-[var(--color-cyan-soft)] underline" href={url('/security')}>report it privately</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={url('/contact')} class="btn btn-primary">Contact the team</a>
        <a href={url('/developers')} class="btn btn-ghost">Developer guide</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
    padding: 2px;
    background: conic-gradient(from 200deg, var(--color-cyan), var(--color-violet), var(--color-blue), var(--color-cyan));
    box-shadow: 0 0 24px rgb(56 189 248 / 0.25);
  }
  .avatar span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background: radial-gradient(circle at 30% 25%, #10244a, var(--color-ink) 75%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: #e0f2fe;
  }
  .avatar-lg {
    width: 7rem;
    height: 7rem;
    padding: 3px;
    box-shadow: 0 0 48px rgb(56 189 248 / 0.3);
  }
  .avatar-lg span {
    font-size: 2.6rem;
  }
  .owner-card::before {
    content: '';
    position: absolute;
    inset: -40% -10% auto auto;
    width: 26rem;
    height: 26rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgb(56 189 248 / 0.12), transparent 65%);
    pointer-events: none;
  }
  .role-chip {
    border: 1px solid var(--color-line-strong);
    border-radius: 9999px;
    background: rgb(14 32 66 / 0.6);
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-cyan-soft);
  }
  .member-card {
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .member-card:hover {
    border-color: var(--color-line-strong);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .member-card:hover {
      transform: none;
    }
  }
</style>
