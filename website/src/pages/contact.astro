---
import SiteLayout from '../layouts/SiteLayout.astro';
import { CONTACT_EMAIL, ISSUES_URL, NEW_ISSUE_URL, REPO_URL, url } from '../lib/site';

const options = [
  {
    title: 'Report a bug',
    body: 'Something broke? Tell us what you did, what happened, and attach setup.log from the install folder if setup failed.',
    href: `${NEW_ISSUE_URL}?labels=bug`,
    cta: 'Open a bug report',
  },
  {
    title: 'Suggest a feature',
    body: 'Ideas for what Orion should do next go on the wishlist.',
    href: url('/wishlist'),
    cta: 'Go to the wishlist',
  },
  {
    title: 'Security issue',
    body: 'Please report vulnerabilities privately, not in a public issue.',
    href: `${REPO_URL}/security/advisories/new`,
    cta: 'Report privately',
  },
  {
    title: 'Browse known issues',
    body: 'See whether a problem is already reported, and follow its fix.',
    href: ISSUES_URL,
    cta: 'Browse issues',
  },
];
---

<SiteLayout title="Contact" description="Report a bug, suggest a feature, or get in touch about Orion.">
  <section class="container-site max-w-4xl pb-10 pt-16 sm:pt-20">
    <p class="eyebrow">Contact</p>
    <h1 class="display mt-4 text-4xl font-bold text-white sm:text-5xl">Get in touch</h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
      Questions, feedback, press or collaboration: email Orion. For bugs and ideas, GitHub is the fastest way to track a fix.
    </p>

    <a href={`mailto:${CONTACT_EMAIL}`} class="panel mt-10 flex flex-wrap items-center justify-between gap-4 p-6 transition-colors hover:border-[var(--color-line-strong)]">
      <span>
        <span class="eyebrow">Email</span>
        <span class="mt-2 block text-xl font-semibold text-white sm:text-2xl">{CONTACT_EMAIL}</span>
        <span class="mt-1 block text-sm text-[var(--color-muted)]">Replies usually within a few days. Please don’t send passwords or keys.</span>
      </span>
      <span class="btn btn-primary">Send an email</span>
    </a>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        options.map((o) => (
          <a href={o.href} class="panel block p-6 transition-colors hover:border-[var(--color-line-strong)]">
            <h2 class="text-lg font-semibold text-white">{o.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{o.body}</p>
            <span class="mt-4 inline-block text-sm font-medium text-[var(--color-cyan-soft)]">{o.cta} →</span>
          </a>
        ))
      }
    </div>
    <p class="mt-10 text-sm text-[var(--color-faint)]">GitHub issues need a free GitHub account. Before reporting, check the <a class="text-[var(--color-cyan-soft)] underline" href={url('/faq')}>FAQ</a> and <a class="text-[var(--color-cyan-soft)] underline" href={url('/docs/troubleshooting')}>troubleshooting guide</a>.</p>
  </section>
</SiteLayout>
