---
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadButton from '../components/DownloadButton.tsx';
import HeroScene from '../components/HeroScene.tsx';
import { REPO_URL, VERSION, url } from '../lib/site';

const features = [
  {
    title: 'Runs on your computer',
    body: 'Orion thinks with a local AI model on your own PC. Your conversations are processed right there, with no account and no subscription.',
    icon: 'chip',
  },
  {
    title: 'Talk or type',
    body: 'Speak naturally and Orion answers out loud, with speech recognition and a voice that both run locally. It greets you when you open it, too.',
    icon: 'wave',
  },
  {
    title: 'Remembers what matters',
    body: 'A personal knowledge graph keeps track of your preferences, notes and past conversations, so you don’t start from zero every time.',
    icon: 'graph',
  },
  {
    title: 'Gets things done',
    body: 'Open apps and websites, play music and videos, change volume, brightness and Wi-Fi, set reminders, search the web and drive your browser.',
    icon: 'bolt',
  },
  {
    title: 'Nothing happens without your yes',
    body: 'Messages, emails and installs are drafted first. Orion only sends a WhatsApp or Telegram message or an email after you approve it.',
    icon: 'shield',
  },
  {
    title: 'Grows new abilities',
    body: 'When no tool fits a request, Orion can write a new one. It’s checked and sandbox-tested, and it only becomes available once you approve it.',
    icon: 'spark',
  },
];

const steps = [
  { n: '01', title: 'Download the installer', body: 'One small file (about 17 MB) for Windows 10 or 11.' },
  { n: '02', title: 'Let setup do the rest', body: 'It installs the AI engine and a model sized to your PC’s memory, plus voice and your chosen extras.' },
  { n: '03', title: 'Say hello', body: 'Open Orion from the Start menu. It greets you, then you can talk, type, or ask it to do things.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Orion',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows 10, Windows 11',
  softwareVersion: VERSION,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: 'An on-device AI assistant for Windows: local AI model, voice, memory, and actions you approve.',
  author: { '@type': 'Person', name: 'Tharun' },
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: REPO_URL,
};
---

<SiteLayout title="Orion" description="Orion is a free, open-source AI assistant that runs on your own Windows PC: a local AI model, voice, memory, and actions that only happen with your approval." schema={schema}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img src={url('/orion-banner.jpg')} alt="" class="hero-poster h-full w-full object-cover object-center opacity-45" fetchpriority="high" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgb(2_6_15/0.15),rgb(2_6_15/0.85)_70%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[var(--color-ink)]"></div>
    </div>
    <div class="absolute inset-0 -z-10 hero-scene" aria-hidden="true">
      <HeroScene client:only="react" />
    </div>
    <!-- Keeps the headline readable over the scene. -->
    <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="container-site flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center py-24 text-center">
      <span class="badge-alpha">Alpha · v{VERSION} · Windows</span>
      <h1 class="display mt-7 text-[clamp(2.6rem,8vw,5.6rem)] font-bold">
        <span class="text-gradient">ORION</span>
      </h1>
      <p class="eyebrow mt-3 !tracking-[0.34em]">Autonomous · Persistent · Self-developing</p>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)] sm:text-xl">
        The AI assistant that lives on <span class="text-white">your</span> computer. It talks, remembers, and gets things done, and your conversations stay on your PC.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <DownloadButton client:load size="lg" requirementsHref={url('/system-requirements')} />
        <a href={url('/system-requirements')} class="btn btn-ghost text-base px-6 py-3.5">Check your PC</a>
      </div>
      <p class="mt-5 text-sm text-[var(--color-faint)]">Free and open source · Windows 10/11, 64-bit · No account needed</p>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="container-site scroll-mt-24 py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">What Orion does</p>
      <h2 class="display mt-4 text-3xl font-semibold text-white sm:text-4xl">A real assistant, not just a chat box</h2>
      <p class="mt-4 text-[var(--color-muted)]">Everything below runs from the desktop app, and all of it is in the alpha today.</p>
    </div>
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <article class="reveal panel p-6 transition-colors hover:border-[var(--color-line-strong)]" style={`transition-delay:${i * 60}ms`}>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-line-strong)] bg-[rgb(56_189_248/0.08)] text-[var(--color-cyan-soft)]">
              {f.icon === 'chip' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></svg>}
              {f.icon === 'wave' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 12h2M7 8v8M11 5v14M15 8v8M19 11v2M21 12h0"/></svg>}
              {f.icon === 'graph' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><circle cx="12" cy="10" r="2"/><path d="M6.7 7l3.6 2M17.3 7l-3.6 2M12 12v4"/></svg>}
              {f.icon === 'bolt' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>}
              {f.icon === 'shield' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>}
              {f.icon === 'spark' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2Z"/><path d="M19 17l.7 2.3L22 20l-2.3.7L19 23l-.7-2.3L16 20l2.3-.7L19 17Z"/></svg>}
            </div>
            <h3 class="mt-5 text-lg font-semibold text-white">{f.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-[var(--color-muted)]">{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- How it works -->
  <section class="container-site py-20">
    <div class="reveal panel overflow-hidden p-8 sm:p-12">
      <p class="eyebrow">Getting started</p>
      <h2 class="display mt-4 text-3xl font-semibold text-white sm:text-4xl">Three steps to your own AI</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {
          steps.map((s) => (
            <li>
              <span class="display text-3xl font-bold text-[rgb(125_211_252/0.35)]">{s.n}</span>
              <h3 class="mt-3 text-lg font-semibold text-white">{s.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-[var(--color-muted)]">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-10 text-sm text-[var(--color-faint)]">
        The first setup downloads the AI engine and model, which can take a while.
        <a class="text-[var(--color-cyan-soft)] underline underline-offset-2" href={url('/docs')}>Read the install guide</a>.
      </p>
    </div>
  </section>

  <!-- Privacy -->
  <section class="container-site grid items-center gap-12 py-20 lg:grid-cols-2">
    <div class="reveal">
      <p class="eyebrow">Private by design</p>
      <h2 class="display mt-4 text-3xl font-semibold text-white sm:text-4xl">Your PC does the thinking</h2>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-muted)]">
        Orion has no servers that read your conversations and no usage tracking. It only goes online when you ask it to: to search, check the weather, or message someone through a service you connected.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('/privacy')} class="btn btn-ghost">Privacy policy</a>
        <a href={url('/security')} class="btn btn-ghost">How approvals work</a>
      </div>
    </div>
    <ul class="reveal grid gap-4">
      {
        [
          ['No account, no analytics', 'Nothing to sign up for, and Orion sends no usage data.'],
          ['Local AI, local voice', 'The model, speech recognition and voice all run on your computer.'],
          ['Signed updates', 'Orion installs an update only if it carries the project’s release signature.'],
          ['You choose what to remove', 'The uninstaller lists what it will delete, including your memories if you want.'],
        ].map(([t, b]) => (
          <li class="panel flex gap-4 p-5">
            <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[var(--color-cyan)] shadow-[0_0_12px_#38bdf8]" aria-hidden="true" />
            <div>
              <p class="font-semibold text-white">{t}</p>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{b}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Requirements teaser -->
  <section class="container-site py-20">
    <div class="reveal grid gap-8 panel p-8 sm:p-12 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div>
        <p class="eyebrow">Will it run?</p>
        <h2 class="display mt-4 text-3xl font-semibold text-white">Made for everyday Windows PCs</h2>
        <p class="mt-4 text-[var(--color-muted)]">
          Orion picks an AI model that fits your PC’s memory. A graphics card makes it faster, but isn’t required.
        </p>
        <a href={url('/system-requirements')} class="btn btn-primary mt-7">Check my PC now</a>
      </div>
      <dl class="grid grid-cols-2 gap-4 text-sm">
        {
          [
            ['System', 'Windows 10 (1809+) or 11, 64-bit'],
            ['Memory', '8 GB recommended'],
            ['Storage', '12 GB free'],
            ['Internet', 'Needed for the first setup'],
          ].map(([k, v]) => (
            <div class="rounded-xl border border-[var(--color-line)] p-4">
              <dt class="text-[var(--color-faint)]">{k}</dt>
              <dd class="mt-1 font-medium text-white">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="container-site py-20 text-center">
    <div class="reveal mx-auto max-w-2xl">
      <h2 class="display text-3xl font-semibold text-white sm:text-5xl"><span class="text-gradient">Try the alpha</span></h2>
      <p class="mt-5 text-lg text-[var(--color-muted)]">
        Built by one developer, in the open. Try it, break it, and tell us what to fix.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <DownloadButton client:visible size="lg" requirementsHref={url('/system-requirements')} />
        <a href={REPO_URL} class="btn btn-ghost text-base px-6 py-3.5">View on GitHub</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero-scene :global(canvas) {
    width: 100% !important;
    height: 100% !important;
  }
  .hero-scene {
    opacity: 0.55;
  }
  .hero-scrim {
    background:
      radial-gradient(ellipse 42% 38% at 50% 50%, rgb(2 6 15 / 0.82), rgb(2 6 15 / 0.35) 70%, transparent),
      linear-gradient(to bottom, transparent 70%, var(--color-ink));
  }
  /* Once the live scene is drawing, the static banner (with its own lettering) steps aside. */
  section:has(.hero-scene canvas) .hero-poster {
    opacity: 0;
    transition: opacity 900ms ease;
  }
</style>
